<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Blabbermouth.Views.MonitorView">
  <ScrollViewer Name="OutputScroller" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <SelectableTextBlock Background="#FF1C1C1C" FontFamily="Consolas, Monospace" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="5" Name="MonitorBlock" />
  </ScrollViewer>
</UserControl>

