<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:blabbermouth="clr-namespace:Blabbermouth"
             xmlns:views="clr-namespace:Blabbermouth.Views"
             xmlns:data="clr-namespace:Blabbermouth.Data"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="250"
             x:Class="Blabbermouth.Views.PhraseList">
    <Grid RowDefinitions="Auto *">
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Left" Text="Activation Phrases" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5 0 0 0" />
            <Button DockPanel.Dock="Right" Content="+" Click="AddClicked" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Width="40" />
        </DockPanel>
        <ListBox Name="PhrasesBox" Grid.Row="1">
            <ListBox.Styles> 
                <Style Selector="ListBoxItem"> <Setter Property="Padding" Value="0" /> </Style> 
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="data:PhraseEntry">
                    <views:PhraseListItem LostFocus="PhraseLostFocus" EnterPressed="PhraseEnterPressed" Remove="PhraseRemove" MoveUp="MovePhraseUp" MoveDown="MovePhraseDown" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

